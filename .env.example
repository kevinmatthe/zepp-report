# 必填：至少 12 字符。不要提交实际 .env。
ADMIN_PASSWORD=
# HTTPS 反向代理设 true；HTTP 访问设 false。
COOKIE_SECURE=false
BUILD_NETWORK=default
ZEPP_ACCOUNT=personal
# 可留空，首次登录 Web UI 后设置；已保存的 UI 配置优先。
ZEPP_USER_ID=
ZEPP_TOKEN=
ZEPP_REGION=global
ZEPP_TIMEZONE=Asia/Shanghai
# 默认使用 Compose 自带的单机 VictoriaMetrics。
VM_IMPORT_URL=http://zepp-vm:8428/api/v1/import
VM_QUERY_URL=http://zepp-vm:8428
VM_RETENTION_DAYS=3650
VM_MEMORY_LIMIT=1g
VM_CPU_LIMIT=2
# 必须与目标 VM 的 dedup.minScrapeInterval 一致（单位秒）。
VM_DEDUP_INTERVAL_SECONDS=0.001
VM_BEARER_TOKEN=
# Grafana profile 可选；留空时初始密码使用 ADMIN_PASSWORD。
GRAFANA_ADMIN_PASSWORD=
# 可固定为 GHCR sha-<完整提交 SHA> 标签。
APP_IMAGE=ghcr.io/kevinmatthe/zepp-report:latest
