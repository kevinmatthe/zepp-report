# 必填：至少 12 字符。不要将实际 .env 提交到版本控制。
ADMIN_PASSWORD=
# 本机默认构建网络 DNS 不可用；仅构建阶段使用 host，运行仍接入 homelab-v2。
BUILD_NETWORK=host
# Traefik HTTPS 保持 true；仅本地 HTTP 开发时设 false。
COOKIE_SECURE=true
ZEPP_ACCOUNT=personal
# 可留空，首次登录 Web UI 后设置；settings.json 存在后以 UI 配置为准。
ZEPP_USER_ID=
ZEPP_TOKEN=
ZEPP_REGION=global
ZEPP_TIMEZONE=Asia/Shanghai
VM_IMPORT_URL=http://vminsert:8480/insert/0/prometheus/api/v1/import
VM_BEARER_TOKEN=
